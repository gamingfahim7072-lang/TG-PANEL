# Server & 24/7 Hosting Environment
PORT=3000
NODE_ENV=production
KEEP_ALIVE=true

# APP_URL: The public HTTPS URL where this application is hosted.
APP_URL="https://your-domain.onrender.com"

# Authentication and Data Encryption
JWT_SECRET="generate_a_secure_jwt_secret_key_here"
ENCRYPTION_KEY="32_character_hex_or_string_key_for_aes_256"

# Payment Gateways (Optional: If configured in env or admin system settings)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""
PHONEPE_SALT_INDEX="1"

# Storage & Uploads
UPLOAD_DIR="./data/uploads"
DATABASE_FILE="./data/telesell.json"

